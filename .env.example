NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-side apenas (Route Handlers). NAO prefixar com NEXT_PUBLIC_:
# a service_role ignora RLS e nunca pode chegar ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Trava de acesso do dashboard (middleware.ts). Server-side apenas.
# A fila tem PII, e o Deployment Protection da Vercel custaria US$150/mes.
DASHBOARD_PASSWORD=
# Assina o cookie de sessao -- string longa e aleatoria. Trocar derruba as sessoes.
DASHBOARD_SESSION_SECRET=
